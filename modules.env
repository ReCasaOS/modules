# The optional modules that every box can install: the catalogue published from
# this repository at each merge on main (README.md).
#
# This is the format of release/modules.env in ReCasaOS/CasaOS-Install, whose
# scripts/build-modules-catalogue.py is the one reader of this file.
#
# A module is four lines. <NAME> is upper case letters, digits and underscores
# and starts with a letter; the name of the module on a box is <NAME> in lower
# case with each underscore a hyphen (VIRT is virt, VIRT_MANAGEMENT is
# virt-management). One assignment to a line, no spaces, no quotes, no comment
# after a value.
#
#   MODULE_<NAME>_TAG        the tag of the module's release: v<number>.<number>.<number>
#   MODULE_<NAME>_COMMIT     the commit that tag must name: 40 lower case hexadecimal digits
#   MODULE_<NAME>_COMPONENT  the module's repository in the ReCasaOS organisation
#   MODULE_<NAME>_TIER       core (maintained by ReCasaOS, proven on a real machine) or community
#
# scripts/build.sh reads checksums.txt and the two archives (amd64 and arm64)
# of that release, checks the tag against the commit, and fails if anything does
# not hold: there is no catalogue with some of its modules missing.
MODULE_VIRT_TAG=v0.2.6
MODULE_VIRT_COMMIT=5d1c179d8ecf6119caf9b8e0d0a385e45a113ba3
MODULE_VIRT_COMPONENT=CasaOS-VirtManagement
MODULE_VIRT_TIER=core
MODULE_VULN_SCAN_TAG=v0.1.3
MODULE_VULN_SCAN_COMMIT=f8ce1ad05b74aba42a7097c71f1f4fb5510e12f6
MODULE_VULN_SCAN_COMPONENT=ReCasaOS-VulnScan
MODULE_VULN_SCAN_TIER=core
MODULE_MCP_TAG=v0.2.1
MODULE_MCP_COMMIT=5d46aee496dc229b32563a52feaa3b719e1fae26
MODULE_MCP_COMPONENT=ReCasaOS-MCP
MODULE_MCP_TIER=core
